{
  "name": "@j0hanz/todokit-mcp",
  "version": "1.1.1",
  "mcpName": "io.github.j0hanz/todokit",
  "description": "A MCP server for Todokit, a task management and productivity tool with JSON storage.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "sideEffects": false,
  "bin": {
    "todokit-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/index.js', '755')\"",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "prepare": "npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx/esm --test tests/*.test.ts",
    "test:coverage": "node --import tsx/esm --test --experimental-test-coverage tests/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "dup-check": "jscpd -c .jscpd.json src",
    "inspector": "npx @modelcontextprotocol/inspector",
    "prepublishOnly": "npm run lint && npm run type-check && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "todo",
    "task-management",
    "productivity",
    "json-storage",
    "todokit"
  ],
  "author": "j0hanz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/j0hanz/todokit-mcp-server.git"
  },
  "homepage": "https://github.com/j0hanz/todokit-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22.19.5",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-de-morgan": "^2.0.0",
    "eslint-plugin-depend": "^1.4.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unused-imports": "^4.3.0",
    "knip": "^5.80.2",
    "jscpd": "4.0.5",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
